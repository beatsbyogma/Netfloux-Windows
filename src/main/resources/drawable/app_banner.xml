    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF000000" android:endColor="#FF14091F" android:angle="315" />
        </shape>
    </item>
    <item android:drawable="@drawable/netfloux_logo"
        android:gravity="center"
        android:width="232dp" android:height="55dp" />
</layer-list>
